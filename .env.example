PORT=3000
NODE_ENV=development
APP_NAME=

# SURREALDB
SURREAL_URL=
SURREAL_NAMESPACE=
SURREAL_DATABASE=
SURREAL_USERNAME=
SURREAL_PASSWORD=

# MONGODB
MONGO_PROTOCOL=
MONGO_CLUSTER=
MONGO_DB_NAME=
MONGO_USERNAME=
MONGO_PASSWORD=
# DNS riêng để resolve SRV của mongodb+srv:// (áp dụng cho TOÀN process). Để trống = DNS hệ thống.
# Trước đây code luôn ép 8.8.8.8; nếu máy chủ cần thì đặt lại:
# MONGO_DNS_SERVERS=8.8.8.8,8.8.4.4
MONGO_DNS_SERVERS=

# CORS (production): danh sách origin, phân tách bằng dấu phẩy. Dùng chung cho HTTP và Socket.IO.
CORS_ORIGIN=
# Đặt khi chạy sau reverse proxy (nginx): 1 | loopback | true. Cần cho rate limit theo IP.
TRUST_PROXY=

# Rate limit đăng nhập admin (theo IP)
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900

# Define default password admin
ADMIN_PASSWORD=


#Redis
# Use auth in production to protect Redis access.
# Option 1: authenticated URL
# REDIS_URL=redis://:yourpassword@localhost:6379
# Option 2: separate components
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=yourpassword
REDIS_USERNAME=
REDIS_URL=redis://localhost:6379
# Prefix pub/sub cho Socket.IO Redis adapter (để trống = "socket.io")
REDIS_SOCKET_IO_KEY=

# JWT
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# RSA Keys for RS256 Token Signing
PUBLIC_KEY=
PRIVATE_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram MTProto (GramJS) để "gọi" admin khi offline. Thiếu 1 trong 3 → tính năng tự tắt.
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=
TELEGRAM_HELPER_SESSION=

# Google Drive upload storage
GOOGLE_DRIVE_FOLDER_ID=
# Option 1: base64-encoded service account JSON
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Option 2: individual service account fields
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# Option 3: OAuth user credentials for personal Gmail / My Drive uploads
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_MAKE_PUBLIC=true
GOOGLE_DRIVE_SUPPORTS_ALL_DRIVES=true
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES_PER_MESSAGE=5
# Kích thước tối đa một packet Socket.IO (MB). Mặc định = base64(UPLOAD_MAX_FILE_SIZE_MB) + 1MB,
# tức tổng file trong MỘT tin gửi qua socket ≈ UPLOAD_MAX_FILE_SIZE_MB. File lớn hơn: dùng REST /message/insert.
SOCKET_MAX_PAYLOAD_MB=

# Image Detector Service AI
IMAGE_DETECTOR_SERVICE_URL=http://0.0.0.0:8000
API_KEY_IMAGE_DETECTOR_SERVICE=

# Logging (pino, JSON ra stdout). LOG_LEVEL: trace | debug | info | warn | error | fatal | silent
# Để trống = info khi NODE_ENV=production, debug khi dev. Test luôn silent.
LOG_LEVEL=
# true = log dễ đọc khi dev (cần devDependency pino-pretty). Production luôn ghi JSON.
LOG_PRETTY=false

# Monitoring stack (docker-compose.monitoring.yml: Loki + Alloy + Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Grafana chỉ bind 127.0.0.1, truy cập qua SSH tunnel hoặc reverse proxy
GRAFANA_PORT=3001
# Tên app PM2 (trùng PM2_APP_NAME trong Jenkinsfile) và thư mục log của PM2
PM2_APP_NAME=community-backend
PM2_LOG_DIR=/root/.pm2/logs
