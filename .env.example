PORT=
NODE_ENV=
APP_NAME=

# Socket.IO — admin join (emit "admin:join" với payload = secret)
ADMIN_SOCKET_SECRET=
# User join room `user:${userId}` (emit "user:join" với { userId, token })
USER_SOCKET_SECRET=

# SURREALDB
SURREAL_URL=
SURREAL_NAMESPACE=
SURREAL_DATABASE=
# SURREAL_USERNAME=
SURREAL_USERNAME=
# SURREAL_PASSWORD=
SURREAL_PASSWORD=

# Redis — Socket.IO adapter (pub/sub khi scale nhiều instance). Để trống nếu chỉ 1 process.
REDIS_URL=
# REDIS_SOCKET_IO_KEY=socket.io

PUBLIC_KEY=

PRIVATE_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Drive upload storage
GOOGLE_DRIVE_FOLDER_ID=
# Option 1: base64-encoded service account JSON
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Option 2: individual service account fields
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# Option 3: OAuth user credentials for personal Gmail / My Drive uploads
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_MAKE_PUBLIC=true
GOOGLE_DRIVE_SUPPORTS_ALL_DRIVES=true
UPLOAD_MAX_FILE_SIZE_MB=10
