PORT=3000
NODE_ENV=development
APP_NAME=

# SURREALDB
SURREAL_URL=
SURREAL_NAMESPACE=
SURREAL_DATABASE=
SURREAL_USERNAME=
SURREAL_PASSWORD=

# MONGODB
MONGO_PROTOCOL=
MONGO_CLUSTER=
MONGO_DB_NAME=
MONGO_USERNAME=
MONGO_PASSWORD=

# Define default password admin
ADMIN_PASSWORD=


#Redis
# Use auth in production to protect Redis access.
# Option 1: authenticated URL
# REDIS_URL=redis://:yourpassword@localhost:6379
# Option 2: separate components
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=yourpassword
REDIS_USERNAME=
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# RSA Keys for RS256 Token Signing
PUBLIC_KEY=
PRIVATE_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Drive upload storage
GOOGLE_DRIVE_FOLDER_ID=
# Option 1: base64-encoded service account JSON
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Option 2: individual service account fields
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# Option 3: OAuth user credentials for personal Gmail / My Drive uploads
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_MAKE_PUBLIC=true
GOOGLE_DRIVE_SUPPORTS_ALL_DRIVES=true
UPLOAD_MAX_FILE_SIZE_MB=10
