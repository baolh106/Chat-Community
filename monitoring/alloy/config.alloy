logging {
  level  = "warn"
  format = "logfmt"
}

local.file_match "pm2" {
  path_targets = [
    {
      "__path__" = "/var/log/pm2/" + sys.env("PM2_APP_NAME") + "-out.log",
      "service"  = "chat-community",
      "stream"   = "stdout",
    },
    {
      "__path__" = "/var/log/pm2/" + sys.env("PM2_APP_NAME") + "-error.log",
      "service"  = "chat-community",
      "stream"   = "stderr",
    },
  ]
  sync_period = "10s"
}

loki.source.file "pm2" {
  targets       = local.file_match.pm2.targets
  forward_to    = [loki.process.app.receiver]
  tail_from_end = true
}

loki.process "app" {
  stage.regex {
    expression = "^[^{]*(?P<payload>\\{.*\\})\\s*$"
  }

  stage.output {
    source = "payload"
  }

  stage.json {
    expressions = {
      level  = "",
      module = "",
      time   = "",
    }
  }

  stage.labels {
    values = {
      level  = "",
      module = "",
    }
  }

  stage.timestamp {
    source            = "time"
    format            = "RFC3339"
    action_on_failure = "skip"
  }

  stage.label_drop {
    values = ["filename"]
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
